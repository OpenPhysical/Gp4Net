#!/usr/bin/env gpshell
# Check Card Capability Information on SCP03-only card

print Checking Card Capability Information on SCP03-only card with factory keys

# Card connection and selection
print Connecting to card...
enable_trace
mode_211
enable_timer
establish_context
card_connect
select -AID A000000151000000

# Authenticate with factory diversified keys
print Authenticating with factory keys...
open_sc -security 3 -keyind 0 -keyver 0 -mac_key 86E6282CE0463C510FD4CB14D2A158EA -enc_key AC2AD8C8E2E874A4C6B514D7ECD5FBE5 -kek_key 7C290D97A5F4891F6C16ED7D2BB0A6E1

# Read current Card Data
print Reading current Card Data...
send_apdu -sc 1 -APDU 80CA006600

# Set SCP default key version to 0xFF  
print Setting SCP default key version to 0xFF...
# Try as DGI: 7F0D (DGI tag) + 01 (DGI length) + FF (data)
send_apdu -sc 1 -APDU 80E28800047F0D01FF

# Also try reading the current default key version
print Reading current default key version...
send_apdu -sc 1 -APDU 80CA7F0D00

# Check if this changes the protocol
print Disconnecting and reconnecting...
card_disconnect
card_connect
select -AID A000000151000000

# Try connecting with SCP03
print Attempting SCP03 connection...
open_sc -security 3 -keyind 0 -keyver 0 -scp 3 -scpimpl 70 -mac_key 86E6282CE0463C510FD4CB14D2A158EA -enc_key AC2AD8C8E2E874A4C6B514D7ECD5FBE5 -kek_key 7C290D97A5F4891F6C16ED7D2BB0A6E1

# Cleanup
card_disconnect
release_context

print
print === Test Complete ===