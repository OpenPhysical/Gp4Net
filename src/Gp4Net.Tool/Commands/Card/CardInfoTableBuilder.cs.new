    /// <summary>
    /// Builds platform and version information rows with 4-column display format.
    /// Shows Tag, Tag Description, Value, and Value Description per GP spec.
    /// </summary>
    private static IEnumerable<TableRow> BuildPlatformInfo(CardInformation cardInfo)
    {
        // Build rows functionally using immutable concatenation
        var headerRow = new[] { new SectionHeader("Platform Identifiers") };

        // Build tag-based rows from card data in 4-column format
        var tagRows = cardInfo.CardData.Match(
            Some: cardData => 
            {
                // Parse OIDs and build 4-column rows
                var oidRows = cardData.Oids
                    .Where(o => !o.StartsWith("1.3.6.1.4.1.42"))
                    .SelectMany(oid => 
                    {
                        var info = GetOidInfo(oid);
                        
                        // Determine which application tag this OID belongs to
                        if (oid == "1.2.840.114283.1")
                        {
                            // Card Recognition Data OID
                            return new[]
                            {
                                new FourColumnRow("[cyan]73[/]", "Card Recognition Data", "", ""),
                                new FourColumnRow("  [cyan]06[/]", "OID", $"[yellow]{oid}[/]", info.Meaning)
                            };
                        }
                        else if (oid.StartsWith("1.2.840.114283.2"))
                        {
                            // Card Management Type and Version
                            return new[]
                            {
                                new FourColumnRow("  [cyan]60[/]", "Application tag 0", "", ""),
                                new FourColumnRow("    [cyan]06[/]", "OID", $"[yellow]{oid}[/]", info.Meaning)
                            };
                        }
                        else if (oid == "1.2.840.114283.3")
                        {
                            // Card Identification Scheme
                            return new[]
                            {
                                new FourColumnRow("  [cyan]63[/]", "Application tag 3", "", ""),
                                new FourColumnRow("    [cyan]06[/]", "OID", $"[yellow]{oid}[/]", info.Meaning)
                            };
                        }
                        else if (oid.StartsWith("1.2.840.114283.4"))
                        {
                            // Secure Channel Protocol
                            return new[]
                            {
                                new FourColumnRow("  [cyan]64[/]", "Application tag 4", "", ""),
                                new FourColumnRow("    [cyan]06[/]", "OID", $"[yellow]{oid}[/]", info.Meaning)
                            };
                        }
                        else
                        {
                            return new[] { new FourColumnRow("  [cyan]06[/]", "OID", $"[yellow]{oid}[/]", info.Meaning) };
                        }
                    })
                    .Cast<TableRow>();

                // Add optional tags
                var optionalTags = new List<TableRow>();
                
                if (cardData.Tags.TryGetValue(0x65, out var configData))
                {
                    optionalTags.Add(new FourColumnRow(
                        "[cyan]65[/]",
                        "Card Configuration Details",
                        $"[dim]{Convert.ToHexString(configData.Take(16).ToArray()).ToLower()}{(configData.Length > 16 ? "..." : "")}[/]",
                        "Optional"
                    ));
                }
                
                if (cardData.Tags.TryGetValue(0x66, out var chipData))
                {
                    optionalTags.Add(new FourColumnRow(
                        "[cyan]66[/]",
                        "Card/Chip Details",
                        $"[dim]{Convert.ToHexString(chipData.Take(16).ToArray()).ToLower()}{(chipData.Length > 16 ? "..." : "")}[/]",
                        "Optional"
                    ));
                }
                
                if (cardData.Tags.TryGetValue(0x67, out var trustData))
                {
                    optionalTags.Add(new FourColumnRow(
                        "[cyan]67[/]",
                        "ISD Trust Point Certificate",
                        $"[dim]{Convert.ToHexString(trustData.Take(16).ToArray()).ToLower()}{(trustData.Length > 16 ? "..." : "")}[/]",
                        "Optional"
                    ));
                }
                
                if (cardData.Tags.TryGetValue(0x68, out var certData))
                {
                    optionalTags.Add(new FourColumnRow(
                        "[cyan]68[/]",
                        "ISD Certificate",
                        $"[dim]{Convert.ToHexString(certData.Take(16).ToArray()).ToLower()}{(certData.Length > 16 ? "..." : "")}[/]",
                        "Conditional"
                    ));
                }
                
                // JavaCard OIDs
                var javaCardRows = cardData.Oids
                    .Where(o => o.StartsWith("1.3.6.1.4.1.42"))
                    .Select(oid => 
                    {
                        var info = GetOidInfo(oid);
                        return new FourColumnRow("", "JavaCard Runtime", $"[yellow]{oid}[/]", info.Meaning) as TableRow;
                    });
                
                return oidRows.Concat(optionalTags).Concat(javaCardRows).ToArray();
            },
            None: () => Array.Empty<TableRow>()
        );

        return headerRow.Concat(tagRows);
    }