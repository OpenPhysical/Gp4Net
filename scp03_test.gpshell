# JCOP4 P71 SCP02 i=15 to SCP03 i=70 Conversion Script
# Starting from GP Pro factory unlock state (GP default test keys installed)

print "Converting P71 card from SCP02 to SCP03 after GP Pro factory unlock"
print "Current state: GP default test keys (404142...) installed as KVN 1"

# Card connection and selection
mode_201
enable_trace
establish_context
card_connect
select -AID A000000151000000

# Step 1: Authenticate with current GP default test keys (KVN 1, SCP02)
print "Step 1: Authenticating with GP default test keys (KVN 1, SCP02)"
open_sc -security 3 -keyind 0 -keyver 1 -mac_key 404142434445464748494A4B4C4D4E4F -enc_key 404142434445464748494A4B4C4D4E4F -kek_key 404142434445464748494A4B4C4D4E4F

# Step 2: Install SCP03 keys with KVN 0x30
print "Step 2: Installing SCP03 keys with KVN 0x30"
put_sc_key -keyver 30 -newkeyver 30 -mac_key 404142434445464748494A4B4C4D4E4F -enc_key 404142434445464748494A4B4C4D4E4F -kek_key 404142434445464748494A4B4C4D4E4F

# Step 3: Test SCP03 functionality before making it default
print "Step 3: Testing SCP03 i=70 functionality"
close_sc

# Establish SCP03 session with new keys (i=70 for full confidentiality)
print "Establishing SCP03 i=70 session (full confidentiality)"
open_sc -security 3 -keyind 0 -keyver 30 -scp 3 -scpimpl 70 -mac_key 404142434445464748494A4B4C4D4E4F -enc_key 404142434445464748494A4B4C4D4E4F -kek_key 404142434445464748494A4B4C4D4E4F

# Test basic functionality
print "Testing basic SCP03 i=70 functionality"
get_status -element 80 -format 1

# Step 4: Set SCP03 as default protocol
print "Step 4: Setting SCP03 as default protocol"
send_apdu -sc 80E28800047F0D0130

# Step 5: Verify the change took effect
print "Step 5: Verifying SCP03 is now default"
get_status -element 80 -format 1

# Step 6: Final test - close and reopen to verify default behavior
print "Step 6: Final test of SCP03 i=70 as default"
close_sc

# Test SCP03 i=70 as default
print "Testing SCP03 i=70 default behavior"
open_sc -security 3 -keyind 0 -keyver 30 -scp 3 -scpimpl 70 -mac_key 404142434445464748494A4B4C4D4E4F -enc_key 404142434445464748494A4B4C4D4E4F -kek_key 404142434445464748494A4B4C4D4E4F

# Final status check
print "Final card status:"
get_status -element 80 -format 1

# Cleanup
close_sc
card_disconnect
release_context

print ""
print "=== CONVERSION TO SCP03 i=70 COMPLETED ==="
print "Card now configured for maximum confidentiality:"
print "- C-MAC: Command integrity"
print "- C-ENCRYPTION: Command confidentiality" 
print "- R-MAC: Response integrity"
print "- R-ENCRYPTION: Response confidentiality"
print ""
print "Use SCP03 i=70 in your Gp4Net tests for full confidentiality"