#!/usr/bin/env gpshell
# Check what Card Data looks like on the SCP03-only card

print Checking Card Data on SCP03-only card

# Card connection and selection
print Connecting to card...
enable_trace
mode_211
enable_timer
establish_context
card_connect
select -AID A000000151000000

# Try to read Card Data without authentication first
print Reading Card Data (no auth)...
send_apdu -sc 0 -APDU 80CA006600

# Authenticate with factory keys using SCP03
print Authenticating with factory keys via SCP03...
open_sc -security 3 -keyind 0 -keyver 0 -scp 3 -scpimpl 70 -mac_key 86E6282CE0463C510FD4CB14D2A158EA -enc_key AC2AD8C8E2E874A4C6B514D7ECD5FBE5 -kek_key 7C290D97A5F4891F6C16ED7D2BB0A6E1

# Read Card Data with auth
print Reading Card Data (with auth)...
send_apdu -sc 1 -APDU 80CA006600

# Read SCP_ENABLE 
print Reading SCP_ENABLE configuration...
send_apdu -sc 1 -APDU 80CA00CF00

# Cleanup
card_disconnect
release_context

print
print === Check Complete ===